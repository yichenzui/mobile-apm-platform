# 环境变量模板
# 使用方式：复制本文件为 .env，并填入真实值（.env 已被 .gitignore 忽略）
#   cp .env.example .env      （Linux/Mac）
#   copy .env.example .env    （Windows）

# 数据库
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT 签名密钥（请使用足够长的随机字符串，生产环境必须更换）
JWT_SECRET=please_change_this_to_a_long_random_string

# DeepSeek AI（可选，留空则 AI 功能不可用，其余功能不受影响）
DEEPSEEK_API_KEY=
