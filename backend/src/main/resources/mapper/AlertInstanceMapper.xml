<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.dao.AlertInstanceMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.monitor.entity.AlertInstance">
        <id column="id" property="id"/>
        <result column="app_key" property="appKey"/>
        <result column="rule_name" property="ruleName"/>
        <result column="rule_id" property="ruleId"/>
        <result column="metric" property="metric"/>
        <result column="severity" property="severity"/>
        <result column="status" property="status"/>
        <result column="current_value" property="currentValue"/>
        <result column="threshold_value" property="thresholdValue"/>
        <result column="message" property="message"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="assignee" property="assignee"/>
        <result column="process_note" property="processNote"/>
        <result column="process_time" property="processTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询告警实例列表 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT 
            id, app_key, rule_name, rule_id, metric, severity, status,
            current_value, threshold_value, message, start_time, end_time,
            assignee, process_note, process_time, create_time, update_time
        FROM 
            alert_instance
        WHERE 
            1=1
            <if test="appKey != null and appKey != ''">
                AND app_key = #{appKey}
            </if>
            <if test="severity != null and severity != ''">
                AND severity = #{severity}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        ORDER BY 
            create_time DESC
        <if test="pageSize != null and pageSize > 0">
            LIMIT #{pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 统计告警数量（条件与 selectList 保持一致） -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM
            alert_instance
        WHERE
            1=1
            <if test="appKey != null and appKey != ''">
                AND app_key = #{appKey}
            </if>
            <if test="severity != null and severity != ''">
                AND severity = #{severity}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
    </select>

</mapper>