<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.dao.IssueMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.monitor.entity.Issue">
        <id column="id" property="id"/>
        <result column="app_key" property="appKey"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="type" property="type"/>
        <result column="severity" property="severity"/>
        <result column="status" property="status"/>
        <result column="stack_trace" property="stackTrace"/>
        <result column="device_info" property="deviceInfo"/>
        <result column="occurrence_count" property="occurrenceCount"/>
        <result column="affected_user_count" property="affectedUserCount"/>
        <result column="first_occurrence_time" property="firstOccurrenceTime"/>
        <result column="last_occurrence_time" property="lastOccurrenceTime"/>
        <result column="assignee" property="assignee"/>
        <result column="process_note" property="processNote"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 查询问题列表 -->
    <select id="selectList" resultMap="BaseResultMap">
        SELECT 
            id, app_key, title, description, type, severity, status,
            stack_trace, device_info, occurrence_count, affected_user_count,
            first_occurrence_time, last_occurrence_time, assignee, process_note,
            create_time, update_time
        FROM 
            issue
        WHERE 
            deleted = 0
            <if test="appKey != null and appKey != ''">
                AND app_key = #{appKey}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="severity != null">
                AND severity = #{severity}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        ORDER BY 
            create_time DESC
        <if test="pageSize != null and pageSize > 0">
            LIMIT #{pageSize} OFFSET #{offset}
        </if>
    </select>

    <!-- 统计问题数量（条件与 selectList 保持一致） -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM
            issue
        WHERE
            deleted = 0
            <if test="appKey != null and appKey != ''">
                AND app_key = #{appKey}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="severity != null">
                AND severity = #{severity}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
    </select>

</mapper>